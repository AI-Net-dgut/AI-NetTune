# ============================================================
# AI-NetTune 后端环境变量模板
# 用法：复制本文件为 .env（或 Windows 下 setx 设置），按实际填写。
# 不配置也能跑：LLM 相关留空时自动降级为规则模板，核心功能不受影响。
# ============================================================

# ---- 大模型（LLM）----
# 留空 = 不启用 LLM，意图识别与研判文案降级为规则模板（接口照常返回）
LLM_API_KEY=
# LLM 接口地址（默认 DeepSeek，换其他模型改这里）
LLM_URL=https://api.deepseek.com/chat/completions
# 模型名
LLM_MODEL=deepseek-chat
# 强制关闭 LLM（即使上面配了 key 也走纯规则）：0 关闭 / 1 启用（默认）
NETTUNE_ENABLE_LLM=1

# ---- 数据与输出目录 ----
# 数据目录整体换位置（留空 = <项目根>/data）
# NETTUNE_DATA_DIR=
# 单独指定网络表 / 频谱表（优先级高于 NETTUNE_DATA_DIR 下的默认候选）
# NETWORK_DATA_PATH=
# SPECTRUM_DATA_PATH=
# 报告输出目录（装在 Program Files 或只读容器时改到可写位置）
# NETTUNE_REPORTS_DIR=

# ---- 运行时调优 ----
# CORS 额外允许来源（逗号分隔；默认已放行 localhost:5173）
# NETTUNE_ALLOW_ORIGINS=http://192.168.1.10:8080
# Prophet 拟合超时（秒），超时自动降级移动平均
# NETTUNE_PROPHET_TIMEOUT=20
# 关闭异常研判缓存（默认开）：1 关闭
# NETTUNE_DISABLE_ANOMALY_CACHE=
# 预测时刻前移标定（分钟）：实测 8 个事件平均偏晚 8.8 分钟，默认前移 8 分钟；
# 设 0 可回到"不标定"的原始行为（详见 scripts/measure_forecast_bias.py）
# NETTUNE_FORECAST_BIAS_MINUTES=8

# ---- 仿真闭环 ----
# 仿真配置存储路径（留空 = <项目根>/data/sim_config.json）；
# 多实例并行或做验收测试时指向独立文件，避免互相覆盖配置历史
# NETTUNE_SIM_CONFIG=

# 用户体验暂定经验门槛，需结合后续实网数据标定，非通用 SLA。
NETTUNE_LLM_INTENT_FIRST=1
NETTUNE_UE_BAD_SHARE_LIMIT=0.10
NETTUNE_UE_PERSIST_MINUTES=5
NETTUNE_UE_MIN_SAMPLES=10
NETTUNE_UE_MIN_VALID_SHARE=0.80
NETTUNE_UE_FRESHNESS_SECONDS=90

# 同一次分析的模型等待预算（秒）；网络失败后本轮使用已有工具结果。
NETTUNE_LLM_BUDGET_SECONDS=30
NETTUNE_LLM_READ_SECONDS=10
