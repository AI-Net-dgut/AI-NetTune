# Python 缓存与编译产物
__pycache__/
*.pyc
*.pyo

# 虚拟环境
.venv/
venv/
env/

# 前端依赖与构建产物
node_modules/
/frontend/node_modules/
dist/
/frontend/dist/
build/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 运行日志与临时文件
*.log
/frontend/*.log
tmp/
temp/

# 前端本地环境变量（.env.example 需要提交，供他人复制）
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# 根目录环境变量（安全兜底）
# 当前 LLM_API_KEY 走系统环境变量（setx），仓库里没有任何 .env 文件；
# 但只要有 .env 留在根目录就可能被 `git add -A` 误提交，这里先堵住。
/.env
/.env.*
!/.env.example
# 其它常见凭据文件名
*.pem
*.key
!data/*.key

# 导出的报告（运行时产物，不入库）
reports/

# 数据文件：体积大（网络表 14.6MB + 频谱表 103.5MB），不纳入 Git。
# 交付方式见 data/README.md 与 DEPLOY.md 第 2 节。
# 用 data/* 而不是 data/ ，否则 git 不会进入该目录，下面的 !data/README.md 会失效。
data/*
!data/README.md
# 数据备份目录（替换数据时自动生成，单个就有 120MB+，绝不能进仓库）
data_backup_*/

# 包管理器缓存
.pnpm-store/
